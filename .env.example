# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit real credentials. Replace every "replace-me" value.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for CSRF-protected requests when the SPA is served
# from a different origin than the API. Leave empty when both share one origin.
DJANGO_CSRF_TRUSTED_ORIGINS=
# json (default) or console for human-readable local output
DJANGO_LOG_FORMAT=json
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
# POSTGRES_PORT is both the published host port and the port Django connects to.
# Change it if 5432 is already used on your machine.
POSTGRES_DB=resolveai
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=replace-me-local-development-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Email (workspace invitations). Development prints messages to the console and tests
# use locmem, so no provider is needed locally. Set a real backend and credentials only
# in deployment.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.com
# Base URL used to build the accept link inside invitation emails. No trailing slash.
FRONTEND_BASE_URL=http://localhost:5173

# Redis and RabbitMQ (reserved for Celery in T5.1; not read by Django yet)
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://resolveai:replace-me-local-rabbitmq-password@127.0.0.1:5672//
RABBITMQ_DEFAULT_USER=resolveai
RABBITMQ_DEFAULT_PASS=replace-me-local-rabbitmq-password
